# Copy this file to .env.local (gitignored) and fill in your value.

# Google Sign-In — fully client-side, no backend required.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials > OAuth client ID > Application type: Web application
# 3. Under "Authorized JavaScript origins" add: http://localhost:3000
#    (and your production URL once you deploy)
# 4. Paste the generated Client ID below.
REACT_APP_GOOGLE_CLIENT_ID=
