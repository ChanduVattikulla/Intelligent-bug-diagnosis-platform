# Copy this file to .env and adjust if needed.

# Neon PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg2://user:password@ep-example.us-east-2.aws.neon.tech/database?sslmode=require

# Local embedding model (downloaded once automatically on first run — needs
# internet the first time only, then it's cached).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Allowed frontend origin for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Optional hosted reasoning model (OpenAI-compatible API). Leave blank to use
# the local deterministic fallback agents.
LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=45

# Caps rows read per CSV file during ingestion (protects against a huge
# research dataset appearing to hang on first run). Raise once you've
# confirmed a dataset's columns map correctly.
MAX_ROWS_PER_FILE=500
